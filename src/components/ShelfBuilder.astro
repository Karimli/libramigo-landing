---
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);

// Watch-only demo: a cursor taps books and they land on the shelf (GSAP, src/scripts/shelf.ts).
// Server-rendered in its final state, so no-JS and reduced-motion visitors see the full shelf.
const books = [
  { id: 'b1', c: 'var(--red)', ink: 'var(--paper)', h: 92, end: 'read' },
  { id: 'b2', c: 'var(--green-500)', ink: 'var(--paper)', h: 84, end: '' },
  { id: 'b3', c: 'var(--amber)', ink: 'var(--green-900)', h: 72, end: 'read' },
  { id: 'b4', c: 'var(--green-900)', ink: 'var(--paper)', h: 96, end: 'reading' },
  { id: 'b5', c: 'var(--spine-ochre)', ink: 'var(--green-900)', h: 88, end: 'read' },
  { id: 'b6', c: 'var(--spine-green)', ink: 'var(--paper)', h: 90, end: 'want' },
];
const statuses = ['read', 'reading', 'want'] as const;
const endCount = (s: string) => books.filter((b) => b.end === s).length;
---
<section id="shelf" class="shelf-section paper">
  <div class="inner">
    <p class="eyebrow" data-i18n="shelf.eyebrow">{t('shelf.eyebrow')}</p>
    <h2 class="section-title" data-i18n="shelf.title">{t('shelf.title')}</h2>
    <p class="section-lead" data-i18n="shelf.subtitle">{t('shelf.subtitle')}</p>

    <!-- Decorative animation: hidden from assistive tech, summarised in this paragraph. -->
    <p class="visually-hidden" data-i18n="shelf.description">{t('shelf.description')}</p>
    <div class="demo" data-shelf-demo aria-hidden="true">
      <div class="picker">
        <div class="status-picker">
          {statuses.map((s) => (
            <span class:list={['status-opt', { on: s === 'want' }]} data-status-opt={s} data-i18n={`shelf.status.${s}`}>{t(`shelf.status.${s}`)}</span>
          ))}
        </div>

        <ul class="books">
          {books.map((b) => (
            <li class="book" data-book={b.id} data-status={b.end || undefined} style={`--c: ${b.c}`}>
              <span class="cover"></span>
              <span class="book-text">
                <span class="book-title" data-i18n={`shelf.books.${b.id}.title`}>{t(`shelf.books.${b.id}.title`)}</span>
                <span class="book-author" data-i18n={`shelf.books.${b.id}.author`}>{t(`shelf.books.${b.id}.author`)}</span>
              </span>
              {statuses.map((s) => (
                <span class:list={['tag', `tag-${s}`]} data-i18n={`shelf.status.${s}`}>{t(`shelf.status.${s}`)}</span>
              ))}
            </li>
          ))}
        </ul>
      </div>

      <div class="board">
        <p class="board-title" data-i18n="shelf.shelfTitle">{t('shelf.shelfTitle')}</p>
        <div class="plank">
          <ul class="spines">
            {books.filter((b) => b.end).map((b) => (
              <li class="shelf-spine" data-spine={b.id} data-status={b.end} style={`--c: ${b.c}; --ink: ${b.ink}; --h: ${b.h}%`}>
                <span class="spine-title" data-i18n={`shelf.books.${b.id}.title`}>{t(`shelf.books.${b.id}.title`)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="counts">
          {statuses.map((s) => (
            <div class:list={['count', `count-${s}`]}>
              <span class="num" data-count={s}>{endCount(s)}</span>
              <span class="label"><span class="mark"></span><span data-i18n={`shelf.status.${s}`}>{t(`shelf.status.${s}`)}</span></span>
            </div>
          ))}
        </div>
      </div>

      <svg class="cursor" width="30" height="34" viewBox="0 0 30 34">
        <circle class="ripple" cx="7" cy="5" r="12"></circle>
        <path d="M5 2 L5 26 L11.5 20.5 L16 31 L20.5 29 L16 18.5 L24.5 18.5 Z" fill="#0A2523" stroke="#F4EDE1" stroke-width="2" stroke-linejoin="round"></path>
      </svg>
    </div>

    <div class="cta-row">
      <a href="#waitlist" class="btn btn-sm" data-i18n="shelf.cta">{t('shelf.cta')}</a>
    </div>
  </div>
</section>

<script>
  import { initShelfDemo } from '../scripts/shelf';
  initShelfDemo();
</script>

<style>
  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: calc(120px * var(--space-scale)) var(--gutter);
  }

  .demo {
    position: relative;
    margin: calc(56px * var(--space-scale)) 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    pointer-events: none;
    user-select: none;
  }
  @media (max-width: 960px) { .demo { grid-template-columns: minmax(0, 1fr); gap: 20px; } }

  /* ---------- Status control ---------- */
  .status-picker {
    padding: 4px;
    border: 1.5px solid var(--paper-line);
    border-radius: 999px;
    display: inline-flex;
    gap: 2px;
    background: var(--paper-card);
  }
  .status-opt {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: calc(16px * var(--type-scale));
    font-weight: 800;
    text-align: center;
    color: var(--green-900);
    transition: background-color 250ms ease, color 250ms ease, filter 180ms ease;
  }
  .status-opt.on { background: var(--green-900); color: var(--paper); }

  /* ---------- Books ---------- */
  .books {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  /* Fixed size: the status badge sits on the card's top edge (absolute) and text never wraps,
     so a card does not grow when it gets selected. */
  .book {
    position: relative;
    height: 64px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--paper-card);
    border: 1.5px solid var(--paper-line);
    border-radius: 12px;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .book[data-status] { border-color: var(--green-900); box-shadow: inset 0 0 0 1px var(--green-900); }
  .cover {
    flex: 0 0 auto;
    width: 26px;
    height: 38px;
    border-radius: 3px 5px 5px 3px;
    background: var(--c);
    box-shadow: inset 4px 0 0 rgba(0, 0, 0, 0.18);
  }
  .book-text { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .book-title, .book-author { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .book-title { font-size: calc(17px * var(--type-scale)); font-weight: 800; line-height: 1.25; }
  .book-author { font-size: max(13px, calc(14px * var(--type-scale))); line-height: 1.3; color: var(--text-on-paper-muted); }
  .tag {
    display: none;
    position: absolute;
    top: -10px;
    right: 10px;
    padding: 3px 9px;
    line-height: 1.2;
    background: var(--paper-card);
    border-radius: 999px;
    font-size: max(12px, calc(12px * var(--type-scale)));
    font-weight: 800;
    white-space: nowrap;
    animation: lm-pop 320ms var(--ease-out) both;
  }
  .book[data-status='read'] .tag-read { display: inline-block; background: var(--green-900); color: var(--paper); }
  .book[data-status='reading'] .tag-reading { display: inline-block; background: var(--amber); color: var(--green-900); }
  .book[data-status='want'] .tag-want { display: inline-block; border: 1.5px dashed var(--green-900); padding: 2px 8px; }

  /* ---------- Shelf board ---------- */
  .board {
    padding: 26px;
    border-radius: var(--radius-card);
    background: var(--paper-card);
    border: 1.5px solid var(--paper-line);
    box-shadow: 0 18px 40px rgba(10, 37, 35, 0.08);
  }
  .board-title { margin: 0; font-family: var(--font-serif); font-style: italic; font-size: calc(26px * var(--type-scale)); font-weight: 600; }
  .plank {
    position: relative;
    margin: 18px 0 0;
    height: 180px;
    padding: 0 12px;
    border-bottom: 12px solid var(--green-900);
    border-radius: 0 0 4px 4px;
  }
  .plank::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -18px;
    height: 6px;
    background: rgba(10, 37, 35, 0.12);
    border-radius: 0 0 6px 6px;
  }
  .spines {
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    align-items: flex-end;
    gap: 5px;
  }
  .shelf-spine {
    position: relative;
    flex: 0 1 38px;
    min-width: 20px;
    height: var(--h);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px 3px 0 0;
    background: var(--c);
    color: var(--ink);
    box-shadow: inset 3px 0 0 rgba(255, 255, 255, 0.12), inset -3px 0 0 rgba(0, 0, 0, 0.14);
    transform-origin: bottom center;
  }
  .shelf-spine[hidden] { display: none; }
  .shelf-spine .spine-title {
    max-height: calc(100% - 22px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .shelf-spine[data-status='reading']::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 6px;
    width: 8px;
    height: 26px;
    background: var(--amber);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%);
  }
  .shelf-spine[data-status='want'] {
    background: transparent;
    color: var(--green-900);
    box-shadow: none;
    outline: 2px dashed var(--c);
    outline-offset: -2px;
  }

  .counts {
    margin: 30px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .count { padding: 12px; border-radius: 12px; background: var(--paper); display: flex; flex-direction: column; gap: 2px; }
  .num { align-self: flex-start; font-family: var(--font-serif); font-size: calc(34px * var(--type-scale)); font-weight: 600; line-height: 1.1; }
  .label { display: flex; align-items: center; gap: 6px; min-width: 0; font-size: max(12px, calc(14px * var(--type-scale))); font-weight: 700; color: var(--text-on-paper-muted); }
  .mark { flex: 0 0 auto; width: 10px; height: 10px; border-radius: 3px; }
  .count-read .mark { background: var(--green-900); }
  .count-reading .mark { background: var(--amber); }
  .count-want .mark { border: 1.5px dashed var(--green-900); }

  /* Fake cursor: hidden until GSAP shows and moves it. */
  .cursor {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    visibility: hidden;
    filter: drop-shadow(0 4px 6px rgba(10, 37, 35, 0.25));
  }
  .ripple { fill: rgba(233, 168, 58, 0.55); opacity: 0; }

  .cta-row { margin: calc(40px * var(--space-scale)) 0 0; display: flex; justify-content: center; }

  /* Phones: compact 2-column book grid so the shelf stays in view while the demo plays. */
  @media (max-width: 620px) {
    .status-picker { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; border-radius: 16px; }
    .status-opt { padding: 6px 8px; border-radius: 12px; line-height: 1.15; }
    .books { gap: 8px; }
    .book { height: 56px; padding: 8px 10px; gap: 10px; }
    .cover { width: 18px; height: 28px; }
    .book-author, .tag { display: none !important; }
    /* up to two lines, always the same card height */
    .book-title {
      font-size: max(14px, calc(15px * var(--type-scale)));
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .board { padding: 18px 16px; }
    .plank { height: 150px; padding: 0 8px; }
    .count { padding: 10px 8px; }
    .cta-row .btn { width: 100%; }
  }
</style>
