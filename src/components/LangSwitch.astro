---
import { languages, useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const current = languages.find((l) => l.code === lang)!;
---
<!-- Desktop: pill with all languages. Phones (with JS): only the active language is shown;
     hover/tap opens the list. Without JS the pill is always shown. -->
<div class="lang" data-lang-menu>
  <button
    type="button"
    class="lang-current"
    aria-expanded="false"
    aria-controls="lang-list"
    data-lang-toggle
  >
    <span class="visually-hidden" data-i18n="nav.langLabel">{t('nav.langLabel')}</span>{' '}
    <span data-lang-current>{current.label}</span>
    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <nav class="lang-switch" id="lang-list" aria-label={t('nav.langLabel')} data-i18n-attr="aria-label:nav.langLabel">
    {languages.map((l) => (
      <a
        href={`/${l.code}`}
        hreflang={l.code}
        lang={l.code}
        data-lang-link={l.code}
        aria-current={l.code === lang ? 'true' : undefined}
      >{l.label}</a>
    ))}
  </nav>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-lang-menu]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-lang-toggle]');
  if (root && toggle) {
    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    root.querySelectorAll('a[data-lang-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) setOpen(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) { setOpen(false); toggle.focus(); }
    });
  }
</script>

<style>
  .lang { position: relative; }
  .lang-switch {
    display: flex;
    gap: 2px;
    margin: 0 8px;
    padding: 4px;
    border: 1px solid rgba(244, 237, 225, 0.25);
    border-radius: 999px;
  }
  .lang-switch a {
    padding: 10px 14px;
    border-radius: 999px;
    font-size: calc(15px * var(--type-scale));
    font-weight: 600;
    text-decoration: none;
    color: var(--paper);
  }
  .lang-switch a:hover { color: var(--paper); }
  .lang-switch a[aria-current='true'],
  .lang-switch a[aria-current='true']:hover {
    background: var(--paper);
    color: var(--green-900);
    font-weight: 700;
  }
  .lang-current { display: none; }

  @media (max-width: 760px) {
    /* Compact trigger in the desktop pill style: thin outline, active language as the light chip. */
    :global(.js) .lang-current {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 8px 4px 4px;
      border: 1px solid rgba(244, 237, 225, 0.25);
      border-radius: 999px;
      background: transparent;
      color: var(--paper);
      font-family: inherit;
      cursor: pointer;
    }
    :global(.js) .lang-current [data-lang-current] {
      padding: 7px 12px;
      border-radius: 999px;
      background: var(--paper);
      color: var(--green-900);
      font-size: calc(15px * var(--type-scale));
      font-weight: 700;
      line-height: 1.2;
    }
    :global(.js) .lang-current svg { transition: transform 200ms var(--ease-out); }
    :global(.js) .is-open .lang-current svg { transform: rotate(180deg); }

    /* Dropdown list over the content. */
    :global(.js) .lang-switch {
      position: absolute;
      top: calc(100% + 4px);
      right: 0;
      z-index: 50;
      flex-direction: column;
      min-width: 100%;
      margin: 0;
      padding: 4px;
      gap: 2px;
      border-radius: 18px;
      background: var(--green-800);
      box-shadow: 0 16px 32px rgba(5, 25, 23, 0.45);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: opacity 180ms ease, transform 180ms var(--ease-out), visibility 0s linear 180ms;
    }
    :global(.js) .lang-switch a { padding: 7px 12px; text-align: center; line-height: 1.2; }
    /* Invisible bridge over the 4px gap so hover does not drop while moving to the list. */
    :global(.js) .lang-switch::before { content: ''; position: absolute; left: 0; right: 0; top: -6px; height: 6px; }
    :global(.js) .is-open .lang-switch {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 180ms ease, transform 180ms var(--ease-out), visibility 0s;
    }
  }
  /* Hover opens the list on devices that can hover. */
  @media (max-width: 760px) and (hover: hover) {
    :global(.js) .lang:hover .lang-switch {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 180ms ease, transform 180ms var(--ease-out), visibility 0s;
    }
  }
</style>
