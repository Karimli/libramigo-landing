---
import { useTranslations, type Lang } from '../i18n';
import { heroReader, quoteReaders } from '../data/readers';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Shelf spines – sizes and colours from reference/AZ.dc.html.
// Quotes the hero card cycles through (GSAP, src/scripts/hero.ts): the hero quote first,
// then the short book quotes from the belt below, each with its demo reader.
const cycle = [1, 4, 5, 6].map((n) => ({ key: `problem.quotes.q${n}`, reader: quoteReaders[n - 1] }));

const spines = [
  { key: 'novel',      w: 46, h: 250, bg: 'var(--red)',         fg: 'var(--paper)',     shade: 0.22 },
  { key: 'poetry',     w: 34, h: 200, bg: 'var(--amber)',       fg: 'var(--green-900)', shade: 0.18 },
  { key: 'history',    w: 56, h: 290, bg: 'var(--paper)',       fg: 'var(--green-900)', shade: 0.14 },
  { key: 'philosophy', w: 40, h: 230, bg: 'var(--green-500)',   fg: 'var(--paper)',     shade: 0.22 },
  { key: 'tales',      w: 50, h: 270, bg: 'var(--red-dark)',    fg: 'var(--paper)',     shade: 0.25 },
  { key: 'drama',      w: 38, h: 210, bg: 'var(--paper-line)',  fg: 'var(--green-900)', shade: 0.14 },
  { key: 'biography',  w: 54, h: 300, bg: 'var(--spine-green)', fg: 'var(--paper)',     shade: 0.25, outlined: true },
  { key: 'scifi',      w: 44, h: 240, bg: 'var(--spine-ochre)', fg: 'var(--green-900)', shade: 0.18 },
  { key: 'essays',     w: 48, h: 260, bg: 'var(--green-300)',   fg: 'var(--green-900)', shade: 0.16, lean: true },
];
---
<section id="top" class="hero">
  <div class="hero-row">
    <div class="hero-text">
      <h1 class="fade" data-i18n="hero.title" data-i18n-reserve>{t('hero.title')}</h1>
      <p class="fade lead" style="animation-delay: 150ms" data-i18n="hero.subtitle" data-i18n-reserve>{t('hero.subtitle')}</p>
      <div class="fade cta-row" style="animation-delay: 300ms">
        <a href="#waitlist" class="btn btn-lg" data-i18n="hero.cta">{t('hero.cta')}</a>
      </div>
    </div>

    <div class="shelf-art" aria-hidden="true">
      <div class="card quote-card" data-hero-card>
        <div class="quote-body">
          <div class="quote-meta">
            <img class="avatar" src={heroReader.avatar} alt="" width="36" height="36" decoding="async" data-hero-avatar />
            <div>
              <div class="reader-name" data-hero-name>{heroReader.name}</div>
              <div class="reader-user" data-hero-user>@{heroReader.username}</div>
            </div>
          </div>
          <p class="serif quote" data-i18n="hero.quote" data-hero-quote>{t('hero.quote')}</p>
          <p class="quote-source" data-hero-source hidden></p>
        </div>
      </div>
      <!-- Pool for the quote cycle; kept in the DOM so the language switch translates it. -->
      <div hidden data-hero-pool>
        <div data-name={heroReader.name} data-user={heroReader.username} data-avatar={heroReader.avatar}>
          <span data-i18n="hero.quote" data-role="text">{t('hero.quote')}</span>
        </div>
        {cycle.map((c) => (
          <div data-name={c.reader.name} data-user={c.reader.username} data-avatar={c.reader.avatar}>
            <span data-i18n={`${c.key}.text`} data-role="text">{t(`${c.key}.text`)}</span>
            <span data-i18n={`${c.key}.source`} data-role="source">{t(`${c.key}.source`)}</span>
          </div>
        ))}
      </div>
      <div class="shelf">
        {spines.map((s, i) => (
          <div
            class:list={['rise', 'slot', { 'slot-lean': s.lean }]}
            style={`--w: ${s.w}px; animation-delay: ${i * 80}ms`}
          >
            <div
              class:list={['spine', { lean: s.lean, outlined: s.outlined }]}
              style={`--h: ${s.h}px; --bg: ${s.bg}; --fg: ${s.fg}; --shade: rgba(0,0,0,${s.shade})`}
            >
              <span data-i18n={`hero.genres.${s.key}`}>{t(`hero.genres.${s.key}`)}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="shelf-board" aria-hidden="true"></div>
</section>

<script is:inline>
  // Safety net: if the animation script never runs, show the static hero after 4s.
  setTimeout(function () { document.documentElement.classList.add('hero-static'); }, 4000);
</script>
<script>
  import { initHeroAnimation } from '../scripts/hero';
  initHeroAnimation();
</script>

<style>
  .hero {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 48px var(--gutter) 0;
  }
  .hero-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 40px;
  }
  /* Wider text column so the longest (Russian) lead fits on two lines on desktop. */
  .hero-text {
    flex: 1 1 660px;
    min-width: 0;
    padding-bottom: 36px;
  }
  h1 {
    margin: 0;
    font-size: clamp(calc(46px * var(--type-scale)), calc(6.2vw * var(--type-scale)), calc(88px * var(--type-scale)));
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 650;
    font-variation-settings: 'opsz' 72;
    text-wrap: balance; /* even lines, e.g. "ortaq rəfi" together on the last line */
  }
  .lead {
    margin: 28px 0 0;
    max-width: 38em;
    font-size: calc(21px * var(--type-scale));
    line-height: 1.6;
    color: var(--text-on-dark);
  }
  .cta-row {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
  }

  /* Illustration */
  .shelf-art {
    flex: 1 1 340px;
    min-width: 0;
    position: relative;
    height: 400px;
  }
  /* Desktop: text and shelf always side by side. The hero's side padding grows with the
     viewport (5%) while max-width is fixed, so the row gets narrower on very wide screens;
     without nowrap the shelf dropped under the text there and the quote card floated. */
  @media (min-width: 1000px) {
    .hero-row { flex-wrap: nowrap; }
  }
  /* Stacked: the shelf area is as wide as its books (~480px), so the quote card stays on them. */
  @media (max-width: 999px) {
    .shelf-art { flex-basis: 100%; max-width: 480px; }
  }
  .quote-card {
    position: absolute;
    top: 0;
    right: 6%;
    z-index: 2;
    width: 350px; /* two lines for the longest (Russian) quote */
    max-width: 94%;
    padding: 16px 18px 18px;
    border-radius: 4px;
    background: var(--paper);
    color: var(--green-900);
    box-shadow: 0 18px 40px rgba(5, 25, 23, 0.45);
  }
  .quote-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: max(12px, calc(14px * var(--type-scale)));
    color: var(--text-on-paper-muted);
  }
  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex: 0 0 auto;
  }
  .reader-name { font-size: calc(15px * var(--type-scale)); font-weight: 800; color: var(--green-900); line-height: 1.25; }
  .reader-user { font-size: max(12px, calc(13px * var(--type-scale))); color: var(--text-on-paper-muted); line-height: 1.3; }
  .quote {
    margin: 14px 0 0;
    font-size: calc(19px * var(--type-scale));
    line-height: 1.4;
    font-style: italic;
  }
  .shelf {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 320px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    padding: 0 4px;
  }
  /* Slots keep reference widths on wide screens and shrink proportionally on narrow ones. */
  .slot {
    flex: 0 1 var(--w);
    min-width: 0;
  }
  .slot-lean { margin-left: 14px; }
  .spine {
    width: 100%;
    height: var(--h);
    background: var(--bg);
    color: var(--fg);
    border-radius: 3px 3px 1px 1px;
    box-shadow: inset 0 22px 0 -16px var(--shade), inset 0 -22px 0 -16px var(--shade);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .spine.outlined { border: 1px solid rgba(244, 237, 225, 0.28); }
  .spine.lean { transform-origin: bottom left; }
  .spine span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: calc(15px * var(--type-scale));
    font-weight: 650;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .quote-source {
    margin: 8px 0 0;
    font-size: max(12px, calc(14px * var(--type-scale)));
    font-weight: 700;
    color: var(--text-on-paper-muted);
  }
  .quote-source::before { content: '— '; }

  /* With JS and motion allowed, GSAP runs the entrance (src/scripts/hero.ts): turn off the
     CSS entrance and keep the pieces hidden until the timeline reveals them. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.hero-static)) .slot,
    :global(html.js:not(.hero-static)) .quote-card,
    :global(html.js:not(.hero-static)) .shelf-board { visibility: hidden; }
    :global(html.js) .slot,
    :global(html.js) .quote-card { animation: none; }
    :global(html.js) .quote-card { transform: rotate(-3deg); }
  }

  .shelf-board {
    height: 16px;
    border-radius: 2px;
    background: var(--amber);
    box-shadow: 0 10px 0 -2px var(--green-900);
  }
</style>
