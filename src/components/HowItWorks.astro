---
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);

// Five-point star, offset horizontally by 21px per star (reference geometry).
const star = (dx: number) =>
  [[9,1],[11.4,6.4],[17,6.9],[12.7,10.6],[14,16],[9,13.1],[4,16],[5.3,10.6],[1,6.9],[6.6,6.4]]
    .map(([x, y]) => `${+(x! + dx).toFixed(1)},${y}`).join(' ');
const stars = [0, 1, 2, 3, 4].map((i) => ({ points: star(i * 21), filled: i < 4, delay: 300 + i * 100 }));
---
<section id="how" class="how">
  <p class="eyebrow" data-i18n="how.eyebrow">{t('how.eyebrow')}</p>
  <h2 class="section-title" data-i18n="how.title">{t('how.title')}</h2>
  <p class="section-lead" data-i18n="how.subtitle">{t('how.subtitle')}</p>

  <ol class="card-grid steps">
    <li class="reveal">
      <div class="lift step">
        <div class="step-head">
          <span class="serif step-num">1</span>
          <h3 data-i18n="how.step1.title">{t('how.step1.title')}</h3>
        </div>
        <div class="mini mini-shelf" aria-hidden="true">
          <div class="book-row">
            <div class="book" style="--c: var(--red)"></div>
            <div class="book-lines">
              <div class="bar dark" style="width: 72%"></div>
              <div class="progress"><div class="fill"></div></div>
            </div>
            <span class="pill pill-amber" data-i18n="how.step1.statusReading">{t('how.step1.statusReading')}</span>
          </div>
          <div class="book-row">
            <div class="book" style="--c: var(--green-500)"></div>
            <div class="book-lines">
              <div class="bar dark" style="width: 58%"></div>
              <div class="bar light" style="width: 40%"></div>
            </div>
            <span class="pill pill-dark">
              <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 6.5 L5 9 L10 3" fill="none" stroke="#F4EDE1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              <span data-i18n="how.step1.statusRead">{t('how.step1.statusRead')}</span>
            </span>
          </div>
          <div class="book-row">
            <div class="book" style="--c: var(--green-300); --book-shade: rgba(0,0,0,0.15)"></div>
            <div class="book-lines">
              <div class="bar dark" style="width: 66%"></div>
              <div class="bar light" style="width: 52%"></div>
            </div>
            <span class="pill pill-outline" data-i18n="how.step1.statusWant">{t('how.step1.statusWant')}</span>
          </div>
        </div>
        <p class="step-text" data-i18n="how.step1.text">{t('how.step1.text')}</p>
      </div>
    </li>

    <li class="reveal">
      <div class="lift step">
        <div class="step-head">
          <span class="serif step-num">2</span>
          <h3 data-i18n="how.step2.title">{t('how.step2.title')}</h3>
        </div>
        <div class="mini mini-review" aria-hidden="true">
          <div class="review-head">
            <span class="avatar"></span>
            <div class="bar dark" style="width: 90px"></div>
            <svg class="stars" width="104" height="18" viewBox="0 0 104 18">
              {stars.map((s) => (
                <polygon class="star" style={`animation-delay: ${s.delay}ms`} points={s.points} fill={s.filled ? '#E9A83A' : '#D9C9A8'}></polygon>
              ))}
            </svg>
          </div>
          <p class="serif review-quote" data-i18n="how.step2.review">{t('how.step2.review')}</p>
          <div class="review-actions">
            <span>
              <svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z" fill="#B8323F"></path></svg>
              <span data-i18n="how.step2.like">{t('how.step2.like')}</span>
            </span>
            <span>
              <svg width="16" height="16" viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z" fill="none" stroke="#3F5A55" stroke-width="2" stroke-linejoin="round"></path></svg>
              <span data-i18n="how.step2.reply">{t('how.step2.reply')}</span>
            </span>
          </div>
        </div>
        <p class="step-text" data-i18n="how.step2.text">{t('how.step2.text')}</p>
      </div>
    </li>

    <li class="reveal">
      <div class="lift step">
        <div class="step-head">
          <span class="serif step-num">3</span>
          <h3 data-i18n="how.step3.title">{t('how.step3.title')}</h3>
        </div>
        <div class="mini mini-shop" aria-hidden="true">
          <div class="float cover"><div class="cover-band"></div></div>
          <div class="shop-info">
            <div class="bar dark" style="width: 80%; height: 10px"></div>
            <div class="bar light" style="width: 55%"></div>
            <span class="delivery">
              <svg width="16" height="16" viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" fill="none" stroke="#12403C" stroke-width="2" stroke-linejoin="round"></path><circle cx="7" cy="17.5" r="1.8" fill="#12403C"></circle><circle cx="17" cy="17.5" r="1.8" fill="#12403C"></circle></svg>
              <span data-i18n="how.step3.delivery">{t('how.step3.delivery')}</span>
            </span>
            <span class="pulse add-to-cart" data-i18n="how.step3.addToCart">{t('how.step3.addToCart')}</span>
          </div>
        </div>
        <p class="step-text" data-i18n="how.step3.text">{t('how.step3.text')}</p>
      </div>
    </li>
  </ol>
</section>

<style>
  .how {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 120px var(--gutter);
  }
  .how .section-title { max-width: 14em; }
  .steps { margin: 64px 0 0; }
  .steps > li { min-width: 0; }
  .step {
    height: 100%;
    padding: 28px;
    border-radius: var(--radius-card);
    background: var(--green-800);
    border: 1px solid rgba(244, 237, 225, 0.14);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .step-head { display: flex; align-items: baseline; gap: 16px; }
  .step-num {
    font-size: 60px;
    line-height: 1;
    font-style: italic;
    font-weight: 600;
    color: var(--amber);
  }
  .step h3 { margin: 0; font-size: 26px; font-weight: 800; letter-spacing: -0.01em; }
  .step-text { margin: 0; font-size: 18px; line-height: 1.6; color: var(--text-on-dark); }

  /* Mini interfaces (decorative) */
  .mini {
    padding: 18px;
    border-radius: 12px;
    background: var(--paper);
    color: var(--green-900);
  }
  .bar { height: 7px; border-radius: 4px; }
  .bar.dark { height: 9px; background: var(--green-900); }
  .bar.light { margin-top: 10px; background: var(--paper-line); }

  .mini-shelf { display: flex; flex-direction: column; gap: 14px; }
  .book-row { display: flex; align-items: center; gap: 12px; }
  .book {
    flex: 0 0 34px;
    height: 48px;
    border-radius: 2px 4px 4px 2px;
    background: var(--c);
    box-shadow: inset 4px 0 0 var(--book-shade, rgba(0, 0, 0, 0.2));
  }
  .book-lines { flex: 1 1 auto; min-width: 0; }
  .progress {
    margin-top: 10px;
    height: 7px;
    border-radius: 4px;
    background: var(--paper-line);
    overflow: hidden;
  }
  .fill { height: 100%; width: 64%; border-radius: 4px; background: var(--amber); }
  .pill {
    flex: 0 0 auto;
    padding: 6px 11px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
  }
  .pill-amber { background: var(--amber); }
  .pill-dark {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--green-700);
    color: var(--paper);
  }
  .pill-outline { padding: 5px 10px; border: 1.5px solid var(--green-900); }

  .mini-review { display: flex; flex-direction: column; gap: 12px; }
  .review-head { display: flex; align-items: center; gap: 10px; }
  .avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--green-500);
    display: inline-block;
    flex: 0 0 auto;
  }
  .stars { margin-left: auto; flex: 0 0 auto; }
  .review-quote {
    margin: 2px 0 0;
    padding-left: 14px;
    border-left: 3px solid var(--red);
    font-size: 19px;
    line-height: 1.45;
    font-style: italic;
  }
  .review-actions {
    display: flex;
    gap: 18px;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-on-paper-muted);
  }
  .review-actions > span { display: inline-flex; align-items: center; gap: 6px; }

  .mini-shop { display: flex; gap: 16px; align-items: stretch; }
  .cover {
    flex: 0 0 78px;
    height: 112px;
    border-radius: 3px 6px 6px 3px;
    background: var(--red-dark);
    box-shadow: inset 6px 0 0 rgba(0, 0, 0, 0.22), 0 10px 18px rgba(10, 37, 35, 0.25);
    display: flex;
    align-items: flex-end;
    padding: 10px;
  }
  .cover-band { height: 6px; width: 100%; border-radius: 3px; background: var(--amber); }
  .shop-info { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .shop-info .bar.light { margin-top: 0; }
  .delivery {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--badge-mint);
    color: var(--green-700);
    font-size: 12px;
    font-weight: 800;
  }
  .add-to-cart {
    margin-top: auto;
    align-self: flex-start;
    padding: 9px 16px;
    border-radius: 8px;
    background: var(--amber);
    font-size: 14px;
    font-weight: 800;
  }
</style>
