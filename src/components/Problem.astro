---
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<section class="problem paper">
  <div class="bookmark" aria-hidden="true"></div>
  <div class="inner">
    <h2 class="serif" data-i18n="problem.title">{t('problem.title')}</h2>
    <p data-i18n="problem.text">{t('problem.text')}</p>
  </div>
</section>

<style>
  .problem {
    margin-top: calc(96px * var(--space-scale));
    position: relative;
  }
  .bookmark {
    position: absolute;
    top: 0;
    left: 5%;
    width: 22px;
    height: 120px;
    background: var(--red);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 84%, 0 100%);
  }
  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: calc(120px * var(--space-scale)) var(--gutter) calc(112px * var(--space-scale));
  }
  h2 {
    margin: 0;
    max-width: 16em;
    font-size: clamp(calc(34px * var(--type-scale)), calc(4.2vw * var(--type-scale)), calc(58px * var(--type-scale)));
    line-height: 1.1;
    letter-spacing: -0.015em;
    font-weight: 600;
    font-style: italic;
  }
  p {
    margin: 32px 0 0;
    max-width: 36em;
    font-size: calc(21px * var(--type-scale));
    line-height: 1.7;
    color: var(--text-on-paper-muted);
  }
</style>
