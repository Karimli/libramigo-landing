---
import { codes, defaultLang, storageKey } from '../i18n/languages.mjs';
import { useTranslations } from '../i18n';
import SeoHead from '../components/SeoHead.astro';

const t = useTranslations(defaultLang);
---
<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <!-- Language redirect page: not indexed itself. Link-preview bots (WhatsApp, Telegram,
         Facebook) don't run the redirect script, so it carries the Azerbaijani share tags,
         canonical and hreflang. -->
    <meta name="robots" content="noindex, follow" />
    <SeoHead lang={defaultLang} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Language: the visitor's own earlier choice, otherwise Azerbaijani (owner decision:
         browser language is not used, so an English browser still lands on /az). -->
    <script is:inline define:vars={{ codes, defaultLang, storageKey }}>
      var lang = null;
      try {
        var stored = localStorage.getItem(storageKey);
        if (codes.indexOf(stored) > -1) lang = stored;
      } catch (e) {}
      location.replace('/' + (lang || defaultLang) + location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=/${defaultLang}`} /></noscript>
  </head>
  <body>
    <a href={`/${defaultLang}`}>Libramigo</a>
  </body>
</html>
