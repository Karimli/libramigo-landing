---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import { codes, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return codes.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const t = useTranslations(lang);
---
<BaseLayout lang={lang}>
  <!-- TEMP (step 2): minimal markup to exercise i18n. Replaced by section components in steps 3–10. -->
  <header class="container" style="padding-top: 28px; display: flex; gap: 16px; align-items: center">
    <LangSwitch lang={lang} />
  </header>
  <main class="container">
    <h1 data-i18n="hero.title">{t('hero.title')}</h1>
    <p data-i18n="hero.subtitle">{t('hero.subtitle')}</p>
    <form id="waitlist">
      <label for="email" data-i18n="waitlist.label">{t('waitlist.label')}</label>
      <input id="email" name="email" type="text" inputmode="email" autocomplete="email"
        placeholder={t('waitlist.placeholder')} data-i18n-attr="placeholder:waitlist.placeholder" />
      <input type="hidden" name="lang" value={lang} data-i18n-lang />
    </form>
    <div style="height: 2000px"></div>
  </main>
</BaseLayout>
