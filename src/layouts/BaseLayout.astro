---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/animations.css';
import SeoHead from '../components/SeoHead.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marks JS support before first paint (mobile menu collapses only with JS). -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} data-i18n-attr="content:meta.description" />
    <SeoHead lang={lang} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- css2 API serves latin, latin-ext and cyrillic subsets via unicode-range -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..800;1,7..72,400..800&family=Manrope:wght@400..800&display=swap"
    />
    <slot name="head" />
    <!-- Analytics placeholder: add tracking snippet here once approved (see brief step 13). -->
  </head>
  <body>
    <slot />
    <div class="visually-hidden" aria-live="polite" data-i18n-announcer></div>
    <script>
      import '../scripts/lang-switch.ts';
    </script>
  </body>
</html>
