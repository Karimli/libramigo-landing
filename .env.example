# Copy to .env and fill in. All values are public (embedded in the built site).

# Site URL for canonical/hreflang/Open Graph absolute URLs (default: https://libramigo.az).
SITE_URL=

# Waitlist endpoint: the Google Apps Script web app URL (…/exec), see backend/README.md.
# Leave empty in development to log submissions to the browser console instead.
PUBLIC_WAITLIST_ENDPOINT=

# Contact email shown in the footer (not decided yet).
PUBLIC_CONTACT_EMAIL=

# Absolute URL of the Open Graph / Twitter share image (not designed yet).
PUBLIC_OG_IMAGE=
